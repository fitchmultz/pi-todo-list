{
  "name": "@fitchmultz/pi-todo-list",
  "version": "0.7.0",
  "description": "A persistent, nested todo list for Pi agents",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "todo",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-todo-list.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-todo-list/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-todo-list#readme",
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/todo-list.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "22.19.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.17.0"
}
